                 {
                  "$class": "WsTextarea",
                  "value": {
                   "$text": [
                    "<div id=\"TheTexte\">L&rsquo;Espace Jeunes est un lieu sp&eacute;cialement con&ccedil;u pour les adolescents de 11 &agrave; 17 ans.<br /> Ces derniers peuvent venir s&rsquo;y d&eacute;tendre, s&rsquo;amuser, s&rsquo;informer et organiser des sorties, des s&eacute;jours, des &eacute;v&egrave;nements, accompagn&eacute;s de L&eacute;o Ayer, directeur de l&rsquo;EJ.</div>\r",
                    "<div></div>\r",
                    "<div></div>\r",
                    "<div></div>\r",
                    "<div><em>Pour plus d'informations, cliquer sur le lien suivant</em></div>\r",
                    "<div></div>\r",
                    "<div><a href=\"https://cdc-entre2mers.fr/non-classe/presentation-4\">cdc-entre2mers.fr</a></div>"
